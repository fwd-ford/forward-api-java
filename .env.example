# forward-api-java environment template
# Copie para .env e preencha. NUNCA commite .env com valores reais.
# Copy to .env and fill in. NEVER commit .env with real values.

# =============================================================================
# Server
# =============================================================================

# HTTP port the Spring Boot app listens on (default 8080).
PORT=8080

# Runtime environment: development | staging | production.
# production = JSON logs and JWT_SECRET becomes mandatory (fail fast).
ENV=development

# Spring profile: empty (external PostgreSQL), demo (embedded PostgreSQL + seed, no Docker)
# or seed (external PostgreSQL + demo seed, use an empty database).
SPRING_PROFILES_ACTIVE=

# Root log level and format (JSON or CONSOLE; default: JSON in production/demo).
LOG_LEVEL=INFO
LOG_FORMAT=CONSOLE

# =============================================================================
# Database (ignored by the demo profile, which starts its own embedded PostgreSQL)
# =============================================================================

# forward-infra docker compose publishes PostgreSQL on host port 55432.
# Create the database once: docker exec forward-postgres createdb -U forward forward_api
DATABASE_URL=jdbc:postgresql://localhost:55432/forward_api?sslmode=disable
DATABASE_USER=forward
DATABASE_PASSWORD=forward_dev

# =============================================================================
# Auth (the API issues and validates its own JWTs, HS256)
# =============================================================================

# Signing key, at least 32 bytes. Generate with: openssl rand -base64 48
# Empty outside production = random key per boot (tokens die on restart).
JWT_SECRET=

# Token lifetime in minutes (1 to 1440).
JWT_EXPIRATION_MINUTES=60

# Server-to-server pre-shared key used by N8N / cron via the X-API-Key header
# (grants the SERVICE profile). Generate with: openssl rand -hex 32
INTERNAL_API_KEY=

# =============================================================================
# CORS, proxy & rate limiting
# =============================================================================

# Comma-separated allowlist. Wildcard entries are ignored on purpose.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081

# Header with the real client IP set by a trusted proxy (Fly.io: Fly-Client-IP).
TRUSTED_CLIENT_IP_HEADER=
# native = honor X-Forwarded-* from a trusted proxy (Fly.io).
FORWARD_HEADERS_STRATEGY=none

# Bucket4j limits per client IP (global and login).
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW=1m
LOGIN_RATE_LIMIT_MAX=5
LOGIN_RATE_LIMIT_WINDOW=1m

# Maximum request body size in bytes (also enforced by Tomcat at 1MB).
MAX_BODY_BYTES=1048576
