<?xml version="1.0" encoding="UTF-8"?>
<!--
  Log format is chosen by the Spring property forward.log-format (see application.yml):
    JSON     structured logs (Logstash encoder) - ENV=production or profile demo
    CONSOLE  human-readable lines - local development and tests
  LOG_FORMAT=JSON|CONSOLE overrides the default. Every line carries the request id (MDC).
  Formato de log escolhido por forward.log-format: JSON em producao/demo, CONSOLE no dev.
-->
<configuration>
    <springProperty name="LOG_FORMAT" source="forward.log-format" defaultValue="CONSOLE"/>
    <springProperty name="APP_VERSION" source="forward.version" defaultValue="dev"/>

    <appender name="JSON" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="net.logstash.logback.encoder.LogstashEncoder">
            <customFields>{"service":"forward-api","version":"${APP_VERSION}"}</customFields>
            <includeMdcKeyName>request_id</includeMdcKeyName>
        </encoder>
    </appender>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} %-5level [%thread] %logger{36} [rid=%X{request_id:-}] - %msg%n</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="${LOG_FORMAT}"/>
    </root>

    <!-- Disabled logger that references both appenders, so logback does not warn about the
         one left unused by LOG_FORMAT. It never emits anything (level OFF). -->
    <logger name="forward.logging.appender-registry" level="OFF" additivity="false">
        <appender-ref ref="JSON"/>
        <appender-ref ref="CONSOLE"/>
    </logger>
</configuration>
